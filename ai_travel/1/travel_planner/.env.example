# Travel Planner 环境配置
# 复制此文件为 .env 并填入您的API密钥

# ========== AI 服务配置 ==========
# 推荐使用 Deepseek API（免费额度大，价格低）
# 官网: https://platform.deepseek.com/
# 注册后，在 API Keys 页面创建密钥
AI_API_KEY=sk-your-deepseek-api-key-here
AI_BASE_URL=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# 备选：讯飞星火 API（如需使用请取消注释并填入）
# AI_API_KEY=your-xunfei-app-id
# AI_API_SECRET=your-xunfei-api-secret
# AI_BASE_URL=https://spark-api.xf-yun.com/v1
# AI_MODEL=general

# 备选：OpenAI API（如需使用请取消注释并填入）
# AI_API_KEY=sk-your-openai-api-key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-3.5-turbo

# ========== 其他配置 ==========
SECRET_KEY=dev-secret-key-change-in-production

# 高德地图API Key（从 https://lbs.amap.com/ 获取，用于地理编码和地图）
AMAP_KEY=your-amap-key

# 天气API Key（如需天气功能，从 https://dev.qweather.com/ 获取）
WEATHER_API_KEY=
